    },
    {
      "ref": "U2",
      "value": "AMS1117-3.3",
      "package": "SOT-223",
      "designator": "LDO"
    },
    {
      "ref": "J3",
      "value": "XH2.54-4P",
      "package": "XH2.54",
      "designator": "传感器接口"
    }
